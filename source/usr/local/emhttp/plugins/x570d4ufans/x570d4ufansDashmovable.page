<?php if ($running): ?>
<script>
function fwFmtTemp(v) { return (v === null || v === undefined) ? '&mdash;' : Number(v).toFixed(1) + '&deg;C'; }
function fwFmtPwm(v)  { return (v === null || v === undefined) ? '&mdash;' : Math.round(v) + '%'; }
function fwFmtFanCell(fans) {
  if (!fans || !fans.length) return '&mdash;';
  if (fans.length === 1) {
    var f = fans[0];
    return (f.rpm !== null && f.rpm !== undefined) ? Math.round(f.rpm) + ' rpm' : f.status;
  }
  return fans.map(function(f) {
    var r = (f.rpm !== null && f.rpm !== undefined) ? Math.round(f.rpm) + ' rpm' : f.status;
    return f.name + ': ' + r;
  }).join(', ');
}
function x570d4ufansRefresh() {
  return $.getJSON('/plugins/x570d4ufans/include/status.php', function(state) {
    var tile = $('#tblX570d4ufans');
    if (!state || !state.running) {
      tile.hide();
      return;
    }
    tile.show();
    var sys = state.system || {};
    var cpu = state.cpu || {};
    var gpu = state.gpu || {};
    var hdd = state.hdd || {};
    $('#fw-system-pwm').html(fwFmtPwm(sys.pwm));
    $('#fw-system-fan').html(fwFmtFanCell(sys.fans));
    $('#fw-cpu-temp').html(fwFmtTemp(cpu.temp));
    $('#fw-cpu-pwm').html(fwFmtPwm(cpu.pwm));
    $('#fw-cpu-fan').html(fwFmtFanCell(cpu.fans));
    $('#fw-gpu-temp').html(fwFmtTemp(gpu.temp));
    $('#fw-gpu-pwm').html(fwFmtPwm(gpu.pwm));
    $('#fw-gpu-fan').html(fwFmtFanCell(gpu.fans));
    $('#fw-hdd-temp').html(fwFmtTemp(hdd.hottest_temp));
    $('#fw-hdd-pwm').html(fwFmtPwm(hdd.pwm));
    $('#fw-hdd-fan').html(fwFmtFanCell(hdd.fans));
    $('#fw-hdd-label').html('_(HDD)_' + (hdd.hottest_name ? ' (' + hdd.hottest_name + ')' : ''));
  });
}
var fwRequestInFlight = false;
function x570d4ufansTick() {
  if (fwRequestInFlight) { setTimeout(x570d4ufansTick, 10000); return; }
  fwRequestInFlight = true;
  x570d4ufansRefresh().always(function() {
    fwRequestInFlight = false;
    setTimeout(x570d4ufansTick, 10000);
  });
}
$(function() {
  if (window.x570d4ufansInited) return;
  window.x570d4ufansInited = true;
  x570d4ufansTick();
});
</script>
